{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artsnack-comfyui-access-stripper",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  // Placeholders: change both to the hostname of your self-hosted ComfyUI (the
  // one behind Cloudflare Access) and its Cloudflare zone before deploying.
  "routes": [
    {
      "pattern": "comfy.example.com/*",
      "zone_name": "example.com",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
