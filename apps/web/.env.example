# Web app (Next.js) environment. Copy to apps/web/.env.local for local dev and set the same
# names in your hosting provider (e.g. Vercel). NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time; everything else stays on the server.

# --- Convex -------------------------------------------------------------------------------
# Required. Convex deployment URL (components/convex-client-provider.tsx, app/layout.tsx).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Clerk (auth) -------------------------------------------------------------------------
# Required. Clerk publishable key, read by @clerk/nextjs (pk_test_… or pk_live_…).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Required. Clerk secret key, read by @clerk/nextjs on the server.
CLERK_SECRET_KEY=sk_test_replace_me
# Required. Issuer of the Clerk instance (proxy.ts); a *.clerk.accounts.dev issuer skips the allowlist.
CLERK_JWT_ISSUER_DOMAIN=https://clerk.example.com
# Required in production. Comma-separated Clerk user ids allowed in (proxy.ts); unset means nobody.
ALLOWED_USER_IDS=user_replace_me

# --- Media --------------------------------------------------------------------------------
# Recommended. Public origin of the media CDN in front of the bucket (packages/shared/media-url.ts,
# next.config.ts `/media/*` rewrite). Unset: media is served through /api/images and /api/videos.
NEXT_PUBLIC_MEDIA_URL=https://media.example.com
# Optional. "on" enables the local media cache service worker (lib/media-cache.ts); off by default.
NEXT_PUBLIC_MEDIA_CACHE=off

# --- Object storage (S3-compatible, e.g. Backblaze B2) ------------------------------------
# Required for the media proxy routes and uploads (lib/b2.ts). Endpoint host without scheme.
B2_ENDPOINT=s3.your-region.backblazeb2.com
# Optional. S3 signing region; derived from a s3.<region>.backblazeb2.com endpoint when unset.
B2_REGION=
# Required. Application key id with access to the bucket.
B2_KEY_ID=replace_me
# Required. Application key secret.
B2_APP_KEY=replace_me
# Required. Bucket holding generated media.
B2_BUCKET_NAME=your-bucket

# --- Self-hosted ComfyUI ------------------------------------------------------------------
# Required for self-hosted generation. Shared secret with Convex for config.comfyuiUrl (lib/comfyui-url.ts).
POD_URL_SECRET=replace_with_a_long_random_string
# Optional. Fallback ComfyUI URL when Convex reports none (lib/comfyui-url.ts); default http://127.0.0.1:8188.
NEXT_PUBLIC_COMFYUI_URL=https://comfy.example.com
# Optional. Server-side alias of the fallback ComfyUI URL, used when NEXT_PUBLIC_COMFYUI_URL is unset.
COMFYUI_API_URL=
# Optional. Legacy RunPod pod URL for the catalogue and upload routes (app/api/loras, lib/backends/runpod.ts).
RUNPOD_URL=
# Optional. X-API-Key sent to the legacy pod URLs above (packages/shared/comfyui-auth.ts).
COMFYUI_API_KEY=
# Optional. Stable public URL of the Vast ComfyUI host behind Cloudflare Access (packages/shared/comfyui-auth.ts).
VAST_BACKEND_PUBLIC_URL=https://comfy.example.com
# Optional. Cloudflare Access service-token id sent only to VAST_BACKEND_PUBLIC_URL.
CF_ACCESS_CLIENT_ID=
# Optional. Cloudflare Access service-token secret sent only to VAST_BACKEND_PUBLIC_URL.
CF_ACCESS_CLIENT_SECRET=
# Optional. Bearer token sent to the legacy pod URLs above (packages/shared/comfyui-auth.ts).
HF_TOKEN=
