# Copy to .env.local (gitignored) and fill in. The Expo CLI loads it for app.config.ts and inlines EXPO_PUBLIC_* into the bundle.
# Required. Convex deployment URL (lib/convex.ts); the app refuses to start without it.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Required. Clerk publishable key, pk_test_… or pk_live_… (app/_layout.tsx); the app refuses to start without it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Required. Public base URL of the media CDN serving generated files (packages/shared/media-url.ts, checked in lib/convex.ts).
EXPO_PUBLIC_MEDIA_URL=https://media.example.com
# Optional. iOS bundle identifier (app.config.ts); defaults to com.example.artsnack.native.
ARTSNACK_BUNDLE_ID=com.example.artsnack.native
# reinstall.sh only, read from the shell environment (export them; this file is not sourced). Target iPhone UDID (`xcrun devicectl list devices`).
# ARTSNACK_DEVICE=00000000-0000000000000000
# reinstall.sh only, read from the shell environment. Apple Developer Team ID used for automatic signing.
# ARTSNACK_TEAM=ABCDE12345
