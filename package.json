{
  "name": "artsnack",
  "version": "0.10.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "oxlint",
    "test": "bun test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && bun run --cwd apps/native typecheck && bun run --cwd apps/desktop typecheck",
    "typecheck:ts7": "node node_modules/typescript-7/bin/tsc --noEmit",
    "convex:dev": "bun run --cwd packages/backend dev",
    "convex:deploy": "bun run --cwd packages/backend deploy",
    "pod:url": "node scripts/set-comfyui-url.mjs",
    "higgsfield:auth": "node scripts/higgsfield-push-credentials.mjs",
    "atlas:sync": "bun scripts/sync-atlas-catalog.mjs",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:dist": "bun run --cwd apps/desktop dist",
    "desktop:install": "bun run --cwd apps/desktop install:local"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "wrangler": "^4.124.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "next@16.2.12": "patches/next@16.2.12.patch"
  },
  "trustedDependencies": [
    "electron",
    "sharp",
    "unrs-resolver"
  ]
}
