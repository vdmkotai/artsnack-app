# Higgsfield worker.
#
# Convex actions cannot spawn processes, and the sanctioned way to reach
# Higgsfield is their CLI — so the CLI lives here, in a stateless container
# function, and Convex drives it over HTTP.
#
# Deployed as its own Vercel project with Root Directory =
# services/higgsfield-worker. It must not sit at the root of the main project:
# a Dockerfile.vercel there would capture all traffic and shadow the Next.js app.

FROM node:22-slim

# The CLI shells out to nothing, but it does fetch over TLS and we download
# reference images before handing them over as local paths.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g @higgsfield/cli@1.1.19

WORKDIR /app
COPY package.json ./
COPY server.js ./

# Credentials arrive per request and are written under this HOME, because the
# container keeps nothing between calls. /tmp is the only writable path.
ENV HOME=/tmp/hfhome
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000
CMD ["node", "server.js"]
