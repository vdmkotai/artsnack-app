# Convex deployment environment. These are NOT read from a file at runtime: set each one on
# every Convex deployment you use (dev and prod do not share variables), either in the Convex
# dashboard (Settings -> Environment Variables) or with `bunx convex env set NAME value`.
# CONVEX_SITE_URL and CONVEX_CLOUD_URL are provided by Convex itself; do not set them.

# --- Auth -----------------------------------------------------------------------------------
# Required. Issuer of the Clerk instance that signs tokens (auth.config.ts, authz.ts).
CLERK_JWT_ISSUER_DOMAIN=https://clerk.example.com
# Required in production. Comma-separated Clerk user ids allowed to call functions (authz.ts); unset means nobody.
ALLOWED_USER_IDS=user_replace_me

# --- Media storage --------------------------------------------------------------------------
# Required. S3 endpoint host of the bucket, without scheme (mediaPipeline.ts).
B2_ENDPOINT=s3.your-region.backblazeb2.com
# Optional. S3 signing region; derived from a s3.<region>.backblazeb2.com endpoint when unset.
B2_REGION=
# Required. Application key id with write access to the bucket.
B2_KEY_ID=replace_me
# Required. Application key secret.
B2_APP_KEY=replace_me
# Required. Bucket holding generated media.
B2_BUCKET_NAME=your-bucket
# Recommended. Public origin of the media CDN; hosted providers fetch reference images from it (mediaPipeline.ts).
MEDIA_BASE_URL=https://media.example.com

# --- Hosted providers -----------------------------------------------------------------------
# Optional. fal.ai API key (falConfig.ts); fal models fail with a clear error without it.
FAL_KEY=
# Optional. Atlas Cloud API key (atlasConfig.ts); Atlas models fail with a clear error without it.
ATLASCLOUD_API_KEY=
# Optional. Overrides the public xAI OAuth client id used for Grok device login (grokConfig.ts).
GROK_CLIENT_ID=
# Optional. URL of the deployed services/higgsfield-worker (higgsfieldConfig.ts).
HIGGSFIELD_WORKER_URL=https://higgsfield-worker.example.com
# Optional. Shared secret matching the worker's WORKER_SECRET.
HIGGSFIELD_WORKER_SECRET=
# Optional. Initial Higgsfield CLI credentials JSON, seeded once into the database (higgsfieldProcessor.ts).
HIGGSFIELD_CREDENTIALS=
# Optional. Higgsfield workspace id to bill against, when the account has several (higgsfieldConfig.ts).
HIGGSFIELD_WORKSPACE_ID=
# Optional. Maximum concurrent Higgsfield jobs, default 4 (higgsfieldConfig.ts).
HIGGSFIELD_MAX_CONCURRENT=

# --- Self-hosted ComfyUI: shared ------------------------------------------------------------
# Required for self-hosted generation. Shared secret with the web app, the pod template and the pods (config.ts, http.ts).
POD_URL_SECRET=replace_with_a_long_random_string
# Required for managed pods. Raw URL of your published infra/provision.sh (provisionScript.ts).
PROVISION_SCRIPT_URL=https://raw.githubusercontent.com/your-org/your-repo/main/infra/provision.sh
# Optional. Hugging Face token passed to managed pods for gated downloads (runpodBackendActions.ts).
HF_TOKEN=
# Optional. Fixed ComfyUI URL used when no managed pod is ready (comfyuiTarget.ts, config.ts).
COMFYUI_API_URL=https://comfy.example.com
# Optional. Alias of COMFYUI_API_URL kept for older setups (comfyuiTarget.ts, config.ts).
NEXT_PUBLIC_COMFYUI_URL=
# Optional. Legacy fixed RunPod pod URL (comfyuiTarget.ts).
RUNPOD_URL=
# Optional. X-API-Key sent to the fixed ComfyUI URLs above (packages/shared/comfyui-auth.ts).
COMFYUI_API_KEY=

# --- Managed RunPod pods --------------------------------------------------------------------
# Required to launch RunPod pods. RunPod API key (runpodBackendActions.ts).
RUNPOD_API_KEY=
# Required to launch RunPod pods. Id of your RunPod template built on CUDA 12.8.
RUNPOD_TEMPLATE_CUDA_12_8_ID=
# Required to launch CUDA 13 pods. Id of your RunPod template built on CUDA 13.0.
RUNPOD_TEMPLATE_CUDA_13_0_ID=
# Optional. Server-side hourly price cap in USD for a RunPod launch.
RUNPOD_MAX_HOURLY_USD=

# --- Managed Vast.ai machine ----------------------------------------------------------------
# Required to launch on Vast. Vast.ai API key (vastBackendActions.ts).
VAST_API_KEY=
# Required to launch on Vast. ComfyUI image pinned by digest, built by .github/workflows/vast-image.yml.
VAST_IMAGE=ghcr.io/your-org/artsnack-comfyui-vast@sha256:replace_with_digest
# Required to launch on Vast. Stable public URL of the Vast ComfyUI host (Cloudflare Tunnel + Access).
VAST_BACKEND_PUBLIC_URL=https://comfy.example.com
# Required to launch on Vast. Cloudflare Tunnel token the machine uses to serve VAST_BACKEND_PUBLIC_URL.
CF_TUNNEL_TOKEN=
# Optional. Cloudflare Access service-token id sent only to VAST_BACKEND_PUBLIC_URL.
CF_ACCESS_CLIENT_ID=
# Optional. Cloudflare Access service-token secret sent only to VAST_BACKEND_PUBLIC_URL.
CF_ACCESS_CLIENT_SECRET=
# Optional. Server-side hourly price cap in USD for a Vast launch.
VAST_MAX_HOURLY_USD=
